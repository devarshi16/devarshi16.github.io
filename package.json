{
  "name": "devarshi-floating-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && astro dev --host 127.0.0.1",
    "dev:drafts": "INCLUDE_DRAFTS=1 npm run dev",
    "check": "astro check",
    "build": "npm run prepare:assets -- --production && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "astro": "7.3.8",
    "marked": "18.1.0",
    "sanitize-html": "2.18.0",
    "three": "0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
