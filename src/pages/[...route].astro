---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Comments from '../components/Comments.astro';
import { render, type CollectionEntry } from 'astro:content';
import { visibleArticles, visibleBooks, allTags, articleUrl } from '../lib/content';
import { projects } from '../data/projects';
import { career } from '../data/career';
type Route = { kind:'article'; article:CollectionEntry<'blogs'> } | { kind:'tag'; tag:string } | { kind:'book'; book:CollectionEntry<'books'> } | { kind:'page'; id:string };
export async function getStaticPaths() {
  const articles=await visibleArticles();const books=await visibleBooks();const tags=await allTags();
  return [
    ...articles.map(article=>({params:{route:`blog/${article.id}`},props:{info:{kind:'article',article} as Route}})),
    ...tags.map(tag=>({params:{route:`tags/${tag}`},props:{info:{kind:'tag',tag} as Route}})),
    ...books.map(book=>({params:{route:`books/${book.id}`},props:{info:{kind:'book',book} as Route}})),
    ...['projects','projects/robotics','projects/vision','projects/hardware','research','about','books'].map(id=>({params:{route:id},props:{info:{kind:'page',id} as Route}})),
  ];
}
const {info}=Astro.props as {info:Route};
const pageTitles:Record<string,string>={projects:'Selected work', 'projects/robotics':'Robotics & robot learning', 'projects/vision':'Computer vision at scale', 'projects/hardware':'The maker workshop', research:'Research & exploration', about:'A little about me', books:'Books & personal writing'};
const title=info.kind==='article'?info.article.data.title:info.kind==='book'?info.book.data.title:info.kind==='tag'?info.tag.replace(/-/g,' '):pageTitles[info.id];
const articles=await visibleArticles();
const renderedArticle=info.kind==='article'?await render(info.article):null;
const ArticleContent=renderedArticle?.Content;
const books=info.kind==='page'&&info.id==='books'?await visibleBooks():[];
---
<Base title={`${title} — Devarshi Aggarwal`}>
  {info.kind==='article'&&<>
    <header class="page-intro article-heading">{info.article.data.category==='Personal writing'?<a class="eyebrow" href="/misc/#writing">← BACK TO POETRY & WRITING</a>:<a class="eyebrow" href="/blog/">← BACK TO THE JOURNAL</a>}<h1>{title}</h1><div class="article-meta"><time datetime={info.article.data.date.toISOString()}>{info.article.data.date.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time><span>{info.article.data.readingMinutes} min read</span><span>{info.article.data.category}</span>{info.article.data.updated&&<span>Updated {info.article.data.updated.toLocaleDateString('en-GB',{month:'short',year:'numeric',timeZone:'UTC'})}</span>}</div><div class="tags">{info.article.data.tags.map(tag=><a href={`/tags/${tag}/`}>{tag.replace(/-/g,' ')}</a>)}</div></header>
    <div class="reading-layout"><nav class="article-toc" aria-label="Table of contents"><p class="eyebrow">IN THIS NOTE</p>{renderedArticle?.headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav><article class="article-body">{!info.article.data.published&&<p class="article-warning">Local draft preview. This article is excluded from the production site.</p>}{ArticleContent&&<ArticleContent/>}<p class="article-warning">Have a question or a different approach? <a href="mailto:devershigpt6@gmail.com">I’d like to hear it.</a></p><Comments enabled={info.article.data.published} /></article></div>
  </>}
  {info.kind==='tag'&&<><section class="page-intro">{info.tag==='poetry'?<a class="eyebrow" href="/misc/#writing">← POETRY & WRITING</a>:<a class="eyebrow" href="/blog/">← THE JOURNAL</a>}<h1>{title}</h1></section><section class="section"><div class="article-grid">{articles.filter(p=>p.data.tags.includes(info.tag)).map((post,index)=><ArticleCard post={post} index={index}/>)}</div>{!articles.some(p=>p.data.tags.includes(info.tag))&&<p>There are no published notes in this category yet.</p>}</section></>}
  {info.kind==='book'&&<><section class="page-intro"><a class="eyebrow" href="/books/">← THE READING GARDEN</a><h1>{title}</h1></section><section class="section case-content"><img src={info.book.data.image} alt={`${info.book.data.title} cover`} width="220"/><p>{info.book.data.description}</p><a class="button primary" href={info.book.data.book_url}>Find the book ↗</a></section></>}
  {info.kind==='page'&&<>
    <section class="page-intro"><a class="eyebrow" href={info.id==='books'?'/misc/#books':'/'}>{info.id==='books'?'← BACK TO MISC':'← BACK TO THE CAMPUS'}</a><h1>{title}<span class="accent-period">.</span></h1><p>{info.id==='projects'?'A selection of work across learning, perception, and physical interfaces.':info.id==='about'?'An engineer who likes understanding how things work—and making them work a little better.':info.id==='research'?'Publications, questions, and the connections between disciplines.':info.id==='books'?'A quieter corner of the campus. Stories and poems alongside the engineering.':'The problems, tools, and decisions behind the work.'}</p></section>
    {info.id==='projects'&&<section class="section project-grid">{projects.map(p=><a class={`project-card project-${p.accent}`} href={p.href}><p class="eyebrow">{p.eyebrow}</p><h2>{p.title}</h2><p>{p.description}</p><span class="text-link">Visit this part of the work ↗</span><div class="tags">{p.tags.map(tag=><span>{tag}</span>)}</div></a>)}</section>}
    {info.id==='projects/robotics'&&<section class="section case-content"><section><p class="eyebrow">PROFESSIONAL WORK · SAMSUNG ELECTRO-MECHANICS</p><h2>Learning-based manipulation in simulation.</h2><p>I develop robotic manipulation environments and learning pipelines using NVIDIA Isaac Sim and Isaac Lab. The work connects task definition, observations and actions, reward design, policy training, rollout evaluation, and failure analysis.</p><div class="tags"><span>Isaac Sim / Isaac Lab</span><span>Reinforcement learning</span><span>Imitation learning</span><span>PyTorch</span></div></section><section><h2>Teleoperation and useful demonstrations.</h2><p>VR teleoperation connects an operator’s motion to a robot’s target pose. I build workflows for collecting demonstrations and preparing observations and actions for imitation-learning experiments.</p><p>The engineering questions are practical: which coordinate frame does a pose belong to, what does an action represent, and how do you tell a usable demonstration from a misleading one?</p></section>{articles.filter(p=>p.data.category==='Robotics').map(post=><section><p class="eyebrow">RELATED ENGINEERING NOTE</p><h2>{post.data.title}</h2><p>{post.data.description}</p><a class="button outline" href={articleUrl(post.id)}>Read the walkthrough ↗</a></section>)}<section><h2>From perception to action.</h2><p>My background in production computer vision informs the way I approach RGB observations, robot proprioception, and experimental evaluation. The goal is a control pipeline whose failures can be understood and improved.</p><div class="case-links"><a href="/projects/vision/">Explore perception work ↗</a><a href="/about/#samsung">Experience and context ↗</a></div></section></section>}
    {info.id==='projects/vision'&&<section class="section case-content"><section><p class="eyebrow">PROFESSIONAL WORK · JIO</p><h2>Real-time systems, end to end.</h2><p>At Jio, I worked on license-plate recognition, people analytics, and access-control systems. This involved detection and recognition models, tracking, reproducible retraining, and deployment.</p><p>Scaling a vision pipeline is also a systems problem. NVIDIA DeepStream supported efficient camera-stream processing, while Milvus provided vector search for feature-based lookup.</p><div class="tags"><span>PyTorch</span><span>DeepStream</span><span>OpenCV</span><span>Milvus</span></div></section><section><p class="eyebrow">PROFESSIONAL WORK · SAMSUNG ELECTRO-MECHANICS</p><h2>Understanding driver attention.</h2><p>I also developed perception models for driver monitoring, including face detection and identification, facial landmarks, gaze estimation, and drowsiness detection.</p></section><section><p class="eyebrow">RESEARCH INTERNSHIP · IIT BOMBAY</p><h2>Vision for rice phenotyping.</h2><p>My earlier work at the Agro Informatics Lab involved differentiating rice genotypes through image features, machine learning, and improved annotation workflows.</p><a class="text-link" href="/research/">View the publication ↗</a></section></section>}
    {info.id==='projects/hardware'&&<section class="section case-content"><section><h2>PICO-8 games on a tiny handheld.</h2><p>Pocket AOT compiles a supported subset of PICO-8 into native RP2040 firmware. Pocket Arcade wraps it in a retro cartridge shelf with conversion diagnostics, flashing and an inspectable status dashboard.</p><a class="button outline" href="/blog/pico-8-to-raspberry-pi-pico/">See the hardware and walkthrough ↗</a></section><section><h2>A USB gamepad, built from scratch.</h2><p>A personal build combining an Arduino Pro Micro, custom PCB wiring, analog inputs, and USB HID firmware. The walkthrough includes the circuit, assembly, firmware, and troubleshooting.</p><a class="button outline" href="/blog/diy-wired-arduino-pro-micro-gamepad/">Read the build ↗</a></section><section><h2>A Raspberry Pi power HAT.</h2><p>A small electronics project exploring how to build a power board for the Raspberry Pi.</p><a class="button outline" href="/blog/diy-raspberry-pi-power-hat/">Read the build ↗</a></section><section><h2>Thinking with physical interfaces.</h2><p>These projects are part of a continuing interest in CAD, 3D printing, and the boundary between software and the physical world.</p><a class="text-link" href="/projects/robotics/">Continue to robotics ↗</a></section></section>}
    {info.id==='research'&&<section class="section case-content"><section><p class="eyebrow">COMPUTER VISION · PLANT PHENOMICS</p><h2>Leaf Count Aided Novel Framework for Rice Genotypes Discrimination in Phenomics.</h2><p>Leveraging computer vision and deep learning applications.</p><a class="text-link" href="https://www.mdpi.com/2223-7747/11/19/2663">Read the paper in Plants ↗</a></section><section><p class="eyebrow">GRAPH ALGORITHMS · IEEE CICT 2020</p><h2>On 3-Degree 4-Chordal Graphs.</h2><a class="text-link" href="https://ieeexplore.ieee.org/document/9312070">Read the paper ↗</a></section><section><h2>Current questions.</h2><p>Robot learning, demonstration quality, simulation-based evaluation, and vision-based control. I’m particularly interested in making the data and decisions inside a learning pipeline easier to inspect.</p><a class="text-link" href="/blog/">Explore the technical journal ↗</a></section></section>}
    {info.id==='about'&&<section class="section case-content"><img class="about-photo" src="/assets/devarshi_passport.jpeg" alt="Devarshi Aggarwal"/><section><h2>Hi, I’m Devarshi.</h2><p>I’m a Robotics & Physical AI Engineer based in Bengaluru. My work spans robot learning, simulation, teleoperation, and production computer vision.</p><p>I like the process of turning a vague problem into something I can build, test, and explain. Along the way, I also make electronics projects and write fiction and poetry.</p><a class="button outline" href="/assets/Devarshi_Aggarwal_CV.pdf">Download my CV ↓</a></section>{career.map(c=><section class="career-detail" id={c.id}><small>{c.dates} · {c.role}</small><h2>{c.name}</h2><p>{c.details}</p><a class="text-link" href={c.link}>Related work ↗</a></section>)}<section><h2>Learning, always.</h2><p>Postgraduate study in AI & ML at BITS Pilani, since July 2025. Undergraduate Computer Science at IIITDM Kancheepuram, 2015–2019.</p><div class="tags"><span>Python</span><span>Isaac Sim / Lab</span><span>PyTorch</span><span>OpenCV</span><span>Docker</span><span>CAD & 3D printing</span></div></section><section id="contact"><p class="eyebrow">LET’S CONNECT</p><h2>Good questions welcome.</h2><div class="case-links"><a href="mailto:devershigpt6@gmail.com">Email ↗</a><a href="https://github.com/devarshi16">GitHub ↗</a><a href="https://www.linkedin.com/in/devarshi-aggarwal/">LinkedIn ↗</a><a href="/misc/">Poetry, books & games ↗</a></div></section></section>}
    {info.id==='books'&&<section class="section"><div class="book-grid">{books.map(book=><article class="book-card"><img src={book.data.image} alt={`${book.data.title} cover`} loading="lazy"/><div><h2>{book.data.title}</h2><p>{book.data.description}</p><a href={`/books/${book.id}/`}>About this book ↗</a></div></article>)}</div><p style="margin-top:40px"><a class="text-link" href="/tags/poetry/">Read the poems ↗</a></p></section>}
  </>}
</Base>
