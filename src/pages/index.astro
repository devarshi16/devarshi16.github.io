---
import Base from '../layouts/Base.astro';
import WorldHero from '../components/WorldHero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsCard from '../components/NewsCard.astro';
import { technicalArticles, visibleNews } from '../lib/content';
import { projects } from '../data/projects';
import { career } from '../data/career';
const posts = await technicalArticles();
const news = (await visibleNews()).slice(0,3);
const preferred = ['vr-teleoperation-so101-isaac-sim','diy-wired-arduino-pro-micro-gamepad','diy-raspberry-pi-power-hat','fast-one-hot-encoding-using-numpy-no-for-loops'];
const featured = preferred.map(id=>posts.find(p=>p.id===id)).filter((p):p is NonNullable<typeof p>=>Boolean(p)).slice(0,3);
---
<Base>
  <WorldHero />
  <section class="section selected-work" id="selected-work"><div class="section-heading"><div><p class="eyebrow">A FEW THINGS I’VE WORKED ON</p><h2>Ideas meet <em>implementation.</em></h2></div><a class="text-link" href="/projects/">All work ↗</a></div><div class="project-grid">{projects.map(p=><a class={`project-card project-${p.accent}`} href={p.href}><div class="project-top"><span>{p.number} / {p.eyebrow}</span><i>↗</i></div><div class="project-illustration" aria-hidden="true">{p.id==='robotics'?<svg viewBox="0 0 280 160"><path d="M65 130V80L130 35L185 75L205 55"/><circle cx="65" cy="80" r="12"/><circle cx="130" cy="35" r="12"/><circle cx="185" cy="75" r="10"/><path d="M35 145H100M195 45L215 65M205 55L225 40"/></svg>:p.id==='vision'?<svg viewBox="0 0 280 160"><rect x="55" y="40" width="170" height="90" rx="12"/><circle cx="140" cy="85" r="35"/><circle cx="140" cy="85" r="20"/><path d="M105 40L115 25H165L175 40M65 57H84M110 145H170"/></svg>:<svg viewBox="0 0 280 160"><rect x="65" y="25" width="150" height="115" rx="10"/><rect x="115" y="60" width="50" height="45"/><path d="M90 45V80H115M165 85H192V120M140 25V60M65 120H115V105M110 25V40H180V60"/></svg>}</div><h3>{p.title}</h3><p>{p.description}</p><div class="tags">{p.tags.map(tag=><span>{tag}</span>)}</div></a>)}</div></section>
  <section class="section journal-section"><div class="section-heading"><div><p class="eyebrow">THE TECHNICAL JOURNAL</p><h2>Build it. Understand it.<br /><em>Write it down.</em></h2></div><a class="text-link" href="/blog/">All technical notes ↗</a></div><div class="article-grid">{featured.map((post,index)=><ArticleCard post={post} index={index} />)}</div></section>
  {news.length>0&&<section class="section news-section"><div class="section-heading"><div><p class="eyebrow">LATELY</p><h2>News from the <em>road.</em></h2></div><a class="text-link" href="/news/">All news ↗</a></div><div class="article-grid">{news.map((item,index)=><NewsCard item={item} index={index} />)}</div></section>}
  <section class="section career-section"><div class="section-heading"><div><p class="eyebrow">A JOURNEY THROUGH THE WORK</p><h2>Different places.<br /><em>One curious mind.</em></h2></div><a class="text-link" href="/about/">More about me ↗</a></div><div class="career-timeline">{career.map(c=><a href={`/about/#${c.id}`}><span class="timeline-dot"></span><small>{c.dates}</small><h3>{c.name}</h3><span>{c.role}</span><p>{c.description}</p></a>)}</div></section>
  <section class="section contact-section"><p class="eyebrow">GOOD WORK STARTS WITH A CONVERSATION</p><h2>Have a problem<br />worth <em>building for?</em></h2><a class="button primary" href="mailto:devershigpt6@gmail.com">Let’s talk <span>↗</span></a><p>Robotics, perception, research, or a delightfully ambitious idea.</p></section>
</Base>
